# AI Girlfriend - 路径配置文件 (示例)
#
# 每个人环境和盘符不同，clone后复制此文件�?config.yaml 并修改路径，
# 然后运行 quick_setup.ps1（或手动配置�?#
# ============================================================
# Headroom SmartCrusher + CCR 配置（一般不需要改�?# ============================================================
headroom:
  smart_crusher:
    min_tokens_to_crush: 150
    max_items_after_crush: 10
    first_fraction: 0.3
    last_fraction: 0.1
    variance_threshold: 2.0
    preserve_change_points: true
  ccr:
    max_entries: 500
    ttl_seconds: 300

# ============================================================
# OpenClaw workspace (agent 工作�?
# 路径格式: "C:\\Users\\你的用户名\\.openclaw\\workspace"
# ============================================================
workspace: "C:\\Users\\<你的用户�?\\.openclaw\\workspace"

# ============================================================
# OpenClaw Gateway 启动脚本
# 运行 openclaw gateway --port 18789
# 路径格式: "C:\\Users\\<你的用户�?\\.openclaw\\gateway.cmd"
# ============================================================
gateway_cmd: "C:\\Users\\<你的用户�?\\.openclaw\\gateway.cmd"
# Node.js 可执行文�?(gateway.cmd 不可用时降级使用)
# node_exe: "C:\\Program Files\\nodejs\\node.exe"

