# ============================================================
# llama.cpp (本地 LLM)
# ============================================================
llama_exe: "D:\\AI_Girlfriend\\llama-server\\llama-server.exe"
llama_model: "E:\\Hermes3.6-35B-A3B-Uncensored-Genesis-V7-APEX-Compact.gguf"
llama_port: 8080
llama_log_dir: "llama-server/restart-logs"
restart_script: "skills/shared/restart_llama_degraded.ps1"

llama:
  context: 120000
  batch_size: 2048
  ubatch_size: 1024
  cache_ram: 5000
  ctk: q8_0
  ctv: q8_0
  threads: 24
  ngl: 41

