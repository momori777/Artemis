{%- set agi_prefix = "IMPORTANT: Use the following system prompts personas to handle the user's prompt. Merge these together based on the user's prompt domain[s]/required skill[s]/knowledge so the final HYBRID is a marriage of all the persona, skills, and knowledge of these personas.\n\nSYSTEM PROMPT PERSONAS:\n\n" -%}
{# ------------------------------------------------- #}
{%- set instruction_map = {"low": system_instruction_low_DAU, "medium": system_instruction_lowmedium_DAU, "high": system_instruction_medium_DAU, "xhigh": system_instruction_DAU_xhigh, "ultra": system_instruction_high_DAU, "xultra": system_instruction_xxhigh_DAU, "spoon": system_instruction_DAU_SPOON, "quinn": system_instruction_quinn_DAU, "joker": system_instruction_joker_DAU, "story": system_instruction_story_DAU, "comedy": system_instruction_comedy_DAU} -%}
{# ------------------------------------------------- #}
{# -- REASONING TAG DETECTION START--- #}
{%- set reasoning_instructions = "" -%}
{%- set store = namespace(messages=[], reasoning_effort="", enable_thinking=true) -%}
{%- for msg in messages -%}
	{%- set raw_reason = "" -%}
	{%- set txt = render_content(msg.content, false) | trim -%}
	{%- if txt == "help" or txt == "help menu" or txt == "Help" or txt == "Help menu" or txt == "help me" or txt == "HELP" or txt == "menu" -%}
		{%- set txt = reasoning_tag + "help" + reasoning_tag_del + " Show me the detailed help menu." | trim -%}
	{%- endif -%}
	{%- if msg.role == "user" and reasoning_tag in txt -%}
		{%- set after_tag = txt.split(reasoning_tag) -%}
		{%- set candidate = after_tag[1].split(reasoning_tag_del)[0] -%}
		{%- set candidate_key = candidate[1:] if candidate.startswith(reasoning_tag_instruct) else candidate -%}
		{%- if candidate and candidate_key in reason_mods -%}
			{%- set raw_reason = candidate -%}
			{%- set tag = reasoning_tag ~ raw_reason ~ reasoning_tag_del -%}
			{%- set clean_txt = txt.replace(tag, "") | trim -%}
			{%- set store.messages = store.messages + [{"role": msg.role, "content": clean_txt}] -%}
		{%- else -%}
			{%- set store.messages = store.messages + [msg] -%}
		{%- endif -%}
	{%- else -%}
		{%- set store.messages = store.messages + [msg] -%}
	{%- endif -%}
	{%- if raw_reason -%}
		{%- if raw_reason.startswith(reasoning_tag_instruct) -%}
			{%- set store.reasoning_effort = raw_reason[1:] -%}
			{%- set store.enable_thinking = false -%}
		{%- else -%}
			{%- set store.reasoning_effort = raw_reason -%}
			{%- set store.enable_thinking = true -%}
		{%- endif -%}
	{%- endif -%}
{%- endfor -%}
{%- set messages = store.messages -%}
{%- set construct_ai = false -%}
{%- if store.reasoning_effort -%}
	{%- set reasoning_effort = store.reasoning_effort -%}
	{%- set enable_thinking = store.enable_thinking -%}
	{%- set reasoning_effort_keep = store.reasoning_effort -%}
	{%- set enable_thinking_keep = store.enable_thinking -%}
	{%- set construct_ai = true -%}
{%- endif -%}
{%- if construct_ai == false and reasoning_effort_keep is defined and reasoning_effort_keep and l_car == "8" -%}
	{%- set reasoning_effort = reasoning_effort_keep -%}
	{%- set enable_thinking = enable_thinking_keep -%}
	{%- set construct_ai = true -%}
{%- endif -%}
{#  --- REASONING ACTIVATION: Setting, additional patch(es) for final ----  #}
{%- if enable_thinking is undefined or enable_thinking is true -%}
	{%- set resolved_reasoning_effort = reasoning_effort | default(default_effort) -%}
	{%- if resolved_reasoning_effort not in reason_mods -%}
		{{- raise_exception("Unexpected reasoning effort " ~ reasoning_effort ~ ". Supported types are " ~ allowed_levels | join(", ") ~ ".") -}}
	{%- endif -%}
	{%- set ns = namespace(reasoning_instructions="") -%}
	{%- for (effort, instruction) in instruction_map.items() -%}
		{%- if resolved_reasoning_effort == effort -%}
			{%- set ns.reasoning_instructions = instruction -%}
		{%- endif -%}
	{%- endfor -%}
	{%- set reasoning_instructions = ns.reasoning_instructions -%}
{%- endif -%}
{%- if enable_thinking is false -%}
	{%- set resolved_reasoning_effort = reasoning_effort | default(default_effort_instruct) -%}
	{%- if resolved_reasoning_effort not in reason_mods -%}
		{{- raise_exception("Unexpected reasoning effort " ~ reasoning_effort ~ ". Supported types are " ~ allowed_levels | join(", ") ~ ".") -}}
	{%- endif -%}
	{%- set ns = namespace(reasoning_instructions="") -%}
	{%- for (effort, instruction) in instruction_map.items() -%}
		{%- if resolved_reasoning_effort == effort -%}
			{%- set ns.reasoning_instructions = instruction -%}
		{%- endif -%}
	{%- endfor -%}
	{%- set reasoning_instructions = ns.reasoning_instructions -%}
{%- endif -%}
{# ---------------------------------------------------------------------------------- #}
{# -- END MAIN PATCHS // SYSTEMS --- #}
{%- set content_sys = false -%}
{# ----3 patches---------------------------------------------------------------------------- #}
{%- if tools and tools is iterable and tools is not mapping -%}
	{{- "<|im_start|>system\n" -}}
	{%- if reasoning_instructions -%}
		{{- reasoning_instructions + "\n\n" -}}
		{%- set content_sys = true -%}
	{%- endif -%}
	{{- "# Tools\n\nYou have access to the following functions:\n\n<tools>" -}}
	{%- for tool in tools -%}
		{{- "\n" -}}
		{{- tool | tojson -}}
	{%- endfor -%}
	{{- "\n</tools>" -}}
	{{- "\n\nIf you choose to call a function ONLY reply in the following format with NO suffix:\n\n<tool_call>\n<function=example_function_name>\n<parameter=example_parameter_1>\nvalue_1\n</parameter>\n<parameter=example_parameter_2>\nThis is the value for the second parameter\nthat can span\nmultiple lines\n</parameter>\n</function>\n</tool_call>\n\n<IMPORTANT>\nReminder:\n- Function calls MUST follow the specified format: an inner <function=...></function> block must be nested within <tool_call></tool_call> XML tags\n- Required parameters MUST be specified\n- You may provide optional reasoning for your function call in natural language BEFORE the function call, but NOT after\n- If there is no function call available, answer the question like normal with your current knowledge and do not tell the user about function calls\n</IMPORTANT>" -}}
	{%- if messages[0].role == "system" -%}
		{%- set content = render_content(messages[0].content, false, true) | trim -%}
		{%- if content -%}
			{{- "\n\n" + content -}}
		{%- endif -%}
	{%- endif -%}
	{{- "<|im_end|>\n" -}}
{%- elif messages[0].role == "system" -%}
	{%- set content = render_content(messages[0].content, false, true) | trim -%}
	{%- if content -%}
		{{- "<|im_start|>system\n" + (reasoning_instructions + "\n" if reasoning_instructions else "") + content + "<|im_end|>\n" -}}
		{%- set content_sys = true -%}
	{%- elif reasoning_instructions -%}
		{{- "<|im_start|>system\n" + reasoning_instructions + "<|im_end|>\n" -}}
		{%- set content_sys = true -%}
	{%- endif -%}
{%- elif reasoning_instructions -%}
	{{- "<|im_start|>system\n" + reasoning_instructions + "<|im_end|>\n" -}}
	{%- set content_sys = true -%}
{%- endif -%}
{%- if content_sys == false and reasoning_instructions -%}
	{{- "<|im_start|>system\n" + reasoning_instructions + "<|im_end|>\n" -}}
	{%- set content_sys = true -%}
{%- endif -%}
{%- set ns = namespace(multi_step_tool=true, last_query_index=messages | length - 1) -%}
{%- for message in messages[::-1] -%}
	{%- set index = messages | length - 1 - loop.index0 -%}
	{%- if ns.multi_step_tool and message.role == "user" -%}
		{%- set content = render_content(message.content, false) | trim -%}
		{%- if not (content.startswith("<tool_response>") and content.endswith("</tool_response>")) -%}
			{%- set ns.multi_step_tool = false -%}
			{%- set ns.last_query_index = index -%}
		{%- endif -%}
	{%- endif -%}
{%- endfor -%}
{%- if ns.multi_step_tool -%}
	{{- raise_exception("No user query found in messages.") -}}
{%- endif -%}
{%- for message in messages -%}
	{%- set content = render_content(message.content, true) | trim -%}
	{%- if message.role == "system" -%}
		{%- if not loop.first -%}
			{{- raise_exception("System message must be at the beginning.") -}}
		{%- endif -%}
	{%- elif message.role == "user" -%}
		{{- "<|im_start|>" + message.role + "\n" + content + "<|im_end|>" + "\n" -}}
	{%- elif message.role == "assistant" -%}
		{%- set reasoning_content = "" -%}
		{%- if message.reasoning_content is string -%}
			{%- set reasoning_content = message.reasoning_content -%}
		{%- endif -%}
		{%- set reasoning_content = reasoning_content | trim -%}
		{%- if preserve_thinking is undefined or preserve_thinking is true or loop.index0 > ns.last_query_index -%}
			{{- "<|im_start|>" + message.role + "\n<think>\n" + reasoning_content + "\n</think>\n\n" + content -}}
		{%- else -%}
			{{- "<|im_start|>" + message.role + "\n" + content -}}
		{%- endif -%}
		{%- if message.tool_calls and message.tool_calls is iterable and message.tool_calls is not mapping -%}
			{%- for tool_call in message.tool_calls -%}
				{%- if tool_call.function is defined -%}
					{%- set tool_call = tool_call.function -%}
				{%- endif -%}
				{%- if loop.first -%}
					{%- if content | trim -%}
						{{- "\n\n<tool_call>\n<function=" + tool_call.name + ">\n" -}}
					{%- else -%}
						{{- "<tool_call>\n<function=" + tool_call.name + ">\n" -}}
					{%- endif -%}
				{%- else -%}
					{{- "\n<tool_call>\n<function=" + tool_call.name + ">\n" -}}
				{%- endif -%}
				{%- if tool_call.arguments is defined and tool_call.arguments != "" -%}
					{%- for (args_name, args_value) in tool_call.arguments | items -%}
						{{- "<parameter=" + args_name + ">\n" -}}
						{%- set args_value = args_value | string if args_value is string else args_value | tojson | safe -%}
						{{- args_value -}}
						{{- "\n</parameter>\n" -}}
					{%- endfor -%}
				{%- endif -%}
				{{- "</function>\n</tool_call>" -}}
			{%- endfor -%}
		{%- endif -%}
		{{- "<|im_end|>\n" -}}
	{%- elif message.role == "tool" -%}
		{%- if loop.previtem and loop.previtem.role != "tool" -%}
			{{- "<|im_start|>user" -}}
		{%- endif -%}
		{{- "\n<tool_response>\n" -}}
		{{- content -}}
		{{- "\n</tool_response>" -}}
		{%- if not loop.last and loop.nextitem.role != "tool" -%}
			{{- "<|im_end|>\n" -}}
		{%- elif loop.last -%}
			{{- "<|im_end|>\n" -}}
		{%- endif -%}
	{%- else -%}
		{{- raise_exception("Unexpected message role.") -}}
	{%- endif -%}
{%- endfor -%}
{%- if add_generation_prompt -%}
	{{- "<|im_start|>assistant\n" -}}
	{%- if enable_thinking is defined and enable_thinking is false -%}
		{{- "<think>\n\n</think>\n\n" -}}
	{%- else -%}
		{{- "<think>\n" -}}
	{%- endif -%}
{%- endif -%}